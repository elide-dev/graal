+            this.symbol = symbol;
+        }
+
+        @Override
+        public Object execute(VirtualFrame frame) {
+            long x = (long) frame.getArguments()[0];
+            try {
+                return (long) handle.invokeExact(symbol, x);
+            } catch (Throwable t) {
