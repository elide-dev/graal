+    @Test
+    public void testStringArgAtStackBoundary(@Inject(StrdupNode.class) CallTarget callTarget) {
+        for (int length : new int[]{254, 255, 256, 257}) {
+            String argument = "x".repeat(length);
+            assertStrdup(callTarget, argument, argument);
