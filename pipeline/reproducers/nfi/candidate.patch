+package com.oracle.truffle.nfi.test;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.oracle.truffle.api.interop.InteropException;
+
+/**
+ * Calls with many arguments. The Native Image backend keeps the argument pointers of calls with up
+ * to 16 arguments in a stack buffer and allocates them for longer calls, so both sides of that
+ * limit are checked. Calls with 32 and 33 long arguments also cross the primitive buffer limit.
+ */
+public class ManyArgumentsNFITest extends NFITest {
+
+    private static void testSum(int count) throws InteropException {
+        StringBuilder signature = new StringBuilder("(");
+        Object[] args = new Object[count];
+        long expected = 0;
+        for (int i = 0; i < count; i++) {
+            signature.append(i == 0 ? "sint64" : ", sint64");
+            // A distinct bit per argument, so a dropped or garbled argument changes the sum.
+            args[i] = 1L << i;
+            expected += 1L << i;
+        }
+        signature.append("):sint64");
+        Object function = lookupAndBind("sum_" + count + "_SINT64", signature.toString());
+        Object result = UNCACHED_INTEROP.execute(function, args);
+        Assert.assertEquals(expected, UNCACHED_INTEROP.asLong(result));
+    }
+
+    @Test
+    public void testSixteenArguments() throws InteropException {
+        testSum(16);
+    }
+
+    @Test
+    public void testSeventeenArguments() throws InteropException {
+        testSum(17);
+    }
+
+    @Test
+    public void testThirtyTwoArguments() throws InteropException {
+        testSum(32);
+    }
+
+    @Test
+    public void testThirtyThreeArguments() throws InteropException {
+        testSum(33);
+    }
+}
